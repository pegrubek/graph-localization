
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bazel: Build pose_graph",
      "type": "shell",
      "command": "bazel",
      "args": [
        "build",
        "-c",
        "dbg",
        "//estimation:pose_graph"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Bazel: Run pose_graph",
      "type": "shell",
      "command": "bazel",
      "args": [
        "run",
        "//estimation:pose_graph"
      ],
      "problemMatcher": []
    },
    {
      "label": "Bazel: Test all",
      "type": "shell",
      "command": "bazel",
      "args": [
        "test",
        "//..."
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Bazel: Refresh compile_commands.json",
      "type": "shell",
      "command": "bazel",
      "args": [
        "run",
        "//:refresh_compile_commands"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
